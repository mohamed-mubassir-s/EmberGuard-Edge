# EmberGuard Edge — Environment
# Copy this file to .env and fill in values as needed.
# NEVER commit .env — it may contain secrets.

# Server
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Demo authentication (hackathon prototype — NOT enterprise-grade)
# ---------------------------------------------------------------------------
# Generate a long random SESSION_SECRET, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me-before-demo
SESSION_SECRET=replace-with-a-long-random-secret
# Session lifetime in seconds (default: 8 hours)
SESSION_MAX_AGE_SECONDS=28800

# Serial (optional — leave blank for simulation-only mode)
SERIAL_PORT=
SERIAL_BAUD=115200

# Blynk (optional — leave blank to disable)
# NEVER paste your auth token here if this file is committed.
# BLYNK_AUTH_TOKEN=
# BLYNK_SERVER=blynk.cloud
# BLYNK_TEMPLATE_ID=

# Database
DATABASE_URL=sqlite+aiosqlite:///./emberguard.db

# Logging
LOG_LEVEL=INFO
